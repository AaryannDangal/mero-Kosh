# ---------------------------------------------------------------------------
# Dhukuti Manager API — environment variables
# Copy to .env for local development. Never commit real secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# PostgreSQL connection (Railway/Render provide this automatically)
DATABASE_URL="postgresql://dhukuti:dhukuti@localhost:5432/dhukuti?schema=public"

# JWT signing secret — REQUIRED in production. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Comma-separated list of allowed browser origins (your Vercel URL in production)
CORS_ORIGINS=http://localhost:5173
# Public URL of the frontend, used for links inside emails
APP_URL=http://localhost:5173
# Number of reverse proxies in front of the API (Railway/Render: 1). Needed for correct client IPs in the audit log and rate limits.
TRUST_PROXY=1

# Uploads (receipts, profile photos). On Railway/Render mount a persistent disk/volume here.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Rate limits (per IP, per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_UPLOAD_MAX=30
RATE_LIMIT_DISABLED=false

# Google Sign-In (optional). Create an OAuth "Web client" ID at console.cloud.google.com and add your frontend URL as an authorised JavaScript origin.
GOOGLE_CLIENT_ID=

# Email (optional). If SMTP_HOST is empty, emails are printed to the server log instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Mero Kosh <no-reply@example.com>"

# Daily reminder job (3 days before due, on due date, overdue after grace period)
ENABLE_SCHEDULER=true
REMINDER_CRON="0 8 * * *"
TZ_REMINDERS=Asia/Kathmandu
